---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const isPortuguese = Astro.locals.starlightRoute.locale === 'pt-br';
const base = import.meta.env.BASE_URL;
const docsHref = isPortuguese ? `${base}pt-br/docs/` : `${base}docs/`;
---

<div class="araru-nav">
  <div class="brand">
    <SiteTitle />
    <a href={docsHref}>Docs</a>
  </div>

  <div class="search print:hidden">
    <Search />
  </div>

  <nav class="actions sl-hidden md:sl-flex print:hidden" aria-label="GitHub and language">
    <div class="github"><SocialIcons /></div>
    <LanguageSelect />
  </nav>
</div>

<style>
  @layer starlight.core {
    :global(header.header) {
      background: var(--sl-color-bg-nav);
      border-bottom-color: var(--sl-color-hairline-shade);
      box-shadow: none;
    }
    .araru-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .75rem;
      width: 100%;
      height: 100%;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: .8rem;
      min-width: 0;
    }
    .brand :global(.site-title) { flex: none; }
    .brand :global(.site-title img) {
      width: auto;
      max-width: 8.25rem;
      height: 2.1rem;
      object-fit: contain;
    }
    .brand :global(.site-title span) { display: none; }
    .brand > a {
      flex: none;
      color: var(--sl-color-gray-2);
      font-size: .82rem;
      font-weight: 650;
      text-decoration: none;
      text-underline-offset: .25em;
    }
    .brand > a:hover { color: var(--sl-color-white); text-decoration: underline; }
    .search {
      display: flex;
      justify-content: center;
      min-width: 0;
    }
    .search :global(site-search),
    .search :global(button[data-open-modal]) { width: 100%; }
    .search :global(button[data-open-modal]) {
      max-width: 36rem;
      border-color: var(--sl-color-gray-5);
      border-radius: .625rem;
      background: var(--sl-color-black);
      transition: border-color .15s ease, color .15s ease;
    }
    .search :global(button[data-open-modal]:hover) { border-color: var(--sl-color-gray-3); }
    .search :global(button[data-open-modal]:focus-visible) {
      border-color: var(--sl-color-accent);
      outline: 2px solid var(--sl-color-accent);
      outline-offset: 2px;
    }
    .actions {
      align-items: center;
      justify-content: flex-end;
      gap: .75rem;
      min-width: 0;
    }
    .github { display: flex; align-items: center; }
    .github :global(a) {
      display: grid;
      place-items: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      border-radius: .5rem;
    }
    .github :global(a:hover) { color: var(--sl-color-white); background: var(--sl-color-gray-6); }
    .actions :global(select) { min-height: 2.75rem; }
    @media (min-width: 50rem) {
      .araru-nav {
        display: grid;
        grid-template-columns: minmax(10rem, 1fr) minmax(18rem, 36rem) minmax(10rem, 1fr);
        gap: clamp(1rem, 3vw, 3rem);
      }
    }
    @media (max-width: 49.99rem) {
      .brand > a { display: none; }
      .brand :global(.site-title img) { max-width: 7rem; height: 2rem; }
      .search { margin-inline-start: auto; }
      .search :global(button[data-open-modal]) {
        display: grid;
        place-items: center;
        min-width: 2.75rem;
        min-height: 2.75rem;
        padding: 0;
      }
    }
  }
</style>
