---
import config from 'virtual:starlight/user-config';
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
const locale = Astro.locals.starlightRoute.locale;
const isPortuguese = locale === 'pt-br';
const base = import.meta.env.BASE_URL;
const localizedRoot = isPortuguese ? `${base}pt-br/` : base;
const docsHref = `${localizedRoot}docs/`;
const docsLabel = isPortuguese ? 'Documentação' : 'Documentation';
---

<div class="header araru-header">
  <div class="header-brand sl-flex">
    <SiteTitle />
    <span class="brand-context" aria-hidden="true"></span>
    <a class="docs-link" href={docsHref}>{docsLabel}</a>
  </div>
  <div class="header-search sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>
  <nav class="sl-hidden md:sl-flex print:hidden header-actions" aria-label={isPortuguese ? 'Preferências e links externos' : 'Preferences and external links'}>
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <LanguageSelect />
    <ThemeSelect />
  </nav>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sl-nav-gap);
      height: 100%;
    }
    .header-brand {
      align-items: center;
      gap: .65rem;
      min-width: 0;
      margin: -.25rem;
      padding: .25rem;
      overflow: clip;
    }
    .brand-context {
      flex: none;
      width: .25rem;
      height: .25rem;
      border-radius: 50%;
      background: var(--araru-warm);
    }
    .docs-link {
      flex: none;
      padding: .25rem;
      color: var(--sl-color-gray-2);
      font-size: .82rem;
      font-weight: 600;
      letter-spacing: .01em;
      text-decoration: none;
      text-underline-offset: .25em;
    }
    .docs-link:hover { color: var(--sl-color-white); text-decoration: underline; }
    .header-search { justify-content: center; min-width: 0; width: 100%; }
    .header-actions, .social-icons { align-items: center; gap: .85rem; }
    .social-icons::after {
      content: '';
      height: 1.5rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }

    @media (min-width: 50rem) {
      .header {
        display: grid;
        grid-template-columns: minmax(11rem, 1fr) minmax(15rem, 38rem) minmax(15rem, 1fr);
      }
      .header-search, .header-search :global(site-search) { width: 100%; }
      .header-actions { justify-self: end; }
    }
    @media (min-width: 50rem) and (max-width: 64rem) {
      .header { grid-template-columns: minmax(10rem, 1fr) minmax(14rem, 24rem) minmax(14rem, 1fr); }
      .docs-link { font-size: .75rem; }
      .header-actions { gap: .5rem; }
    }
    @media (max-width: 49.99rem) {
      .brand-context, .docs-link { display: none; }
    }
    @media (max-width: 30rem) {
      .header-brand { gap: .4rem; }
    }
  }
</style>
